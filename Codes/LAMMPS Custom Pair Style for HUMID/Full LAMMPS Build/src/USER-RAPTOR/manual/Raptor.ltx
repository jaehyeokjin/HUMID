: cutoff for OO
2.85   3.05

: cutoff for OH
2.3    2.5
  #endif

  #ifdef EVB2
14.014       : B
2.20         : b
0.000000     : b'
2.40         : d_OO
7.387        : C
3.60         : c
0.98         : d_OH

: cutoff for OO
2.85   3.05

